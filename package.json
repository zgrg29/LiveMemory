{
  "name": "livememory",
  "version": "0.8.1",
  "private": true,
  "description": "LiveMemory — local-first livestream memory system for Bilibili Live and YouTube Live.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "main": "src/launcher/launcher.mjs",
  "scripts": {
    "start": "node src/launcher/launcher.mjs",
    "dev": "node src/launcher/launcher.mjs --no-open",
    "test": "node --test tests/unit tests/integration",
    "test:single": "node --test --test-isolation=none \"tests/unit/*.test.mjs\" \"tests/integration/*.test.mjs\"",
    "test:unit": "node --test tests/unit",
    "test:integration": "node --test tests/integration",
    "build:windows": "node scripts/build-windows.mjs"
  }
}
