{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livememory.local/schemas/memory-update-result-v1.schema.json",
  "title": "LiveMemory long-term memory update v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "task_id", "session_id", "locale", "viewer_operations"],
  "properties": {
    "protocol": {"const": "livememory-memory-update-v1"},
    "schema_version": {"enum": ["1.0.0"]},
    "job_id": {"type": "string", "minLength": 1, "maxLength": 100},
    "batch_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "broadcaster_id": {"type": ["string", "null"], "maxLength": 200},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 100},
    "locale": {"enum": ["zh-CN", "ja", "en"]},
    "viewer_operations": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["viewer_id", "operations"],
        "properties": {
          "viewer_id": {"type": "string", "minLength": 1, "maxLength": 200},
          "summary": {"type": "string", "maxLength": 800},
          "operations": {
            "type": "array",
            "maxItems": 40,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["op"],
              "properties": {
                "op": {
                  "enum": ["add", "confirm", "update", "supersede", "conflict", "outdated", "uncertain"]
                },
                "kind": {
                  "enum": ["interest", "dislike", "identity", "life_event", "topic", "preference", "community", "other"]
                },
                "topic": {"type": "string", "maxLength": 80},
                "statement": {"type": "string", "maxLength": 400},
                "certainty": {"enum": ["stated", "inferred", "uncertain"]},
                "confidence": {"type": "number", "minimum": 0, "maximum": 1},
                "target_fact_id": {"type": "string", "minLength": 1, "maxLength": 60},
                "reason": {"type": "string", "maxLength": 200},
                "valid_from": {"type": "string", "format": "date-time"},
                "valid_until": {"type": "string", "format": "date-time"},
                "evidence": {
                  "type": "array",
                  "maxItems": 50,
                  "items": {
                    "oneOf": [
                      {"type": "integer", "minimum": 1},
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["batch", "seq"],
                        "properties": {
                          "batch": {"type": "integer", "minimum": 1},
                          "seq": {"type": "integer", "minimum": 1}
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
